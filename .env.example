# Postgres connection string (Devtron secret in prod). App runs fail-open
# without this — generic fallback astrologer/price is shown, nothing crashes.
DATABASE_URL=

# Redash sync (Devtron secret in prod). Needed either way — for a manual
# `node sync-redash.js` run, a Devtron CronJob, or the in-app setInterval
# loop below. Just having these set does NOT start any recurring sync on
# its own; see REDASH_AUTO_SYNC.
#
# REDASH_QUERY_URL can be either the full /api/queries/<id> URL, or you can
# set REDASH_HOST + REDASH_QUERY_ID separately instead (either works).
#
# The sync does a plain GET against Redash's already-cached results — it
# does NOT trigger execution. Someone needs to have run the query at least
# once in the Redash UI (a one-time action, not a recurring schedule) before
# this can read anything.
REDASH_QUERY_URL=
REDASH_API_KEY=
# How long to wait for Redash to respond before giving up (ms).
REDASH_FETCH_TIMEOUT_MS=20000

# Set to "true" to make server.js run the sync itself on a setInterval loop
# (Option B from the brief). Leave unset/false if you're syncing manually
# (`node sync-redash.js`) or via a separate Devtron CronJob (Option A) —
# otherwise the main app would ALSO start its own recurring sync just
# because REDASH_QUERY_URL/REDASH_API_KEY happen to be set.
REDASH_AUTO_SYNC=false
# Only used when REDASH_AUTO_SYNC=true.
REDASH_SYNC_INTERVAL_MINUTES=10

# Fallback astrologer shown when user_id is missing or not found in DB
DEFAULT_ASTRO_NAME=Our Astrologer
DEFAULT_ASTRO_CPM=20

# Emergency rate = astro_cpm * EMERGENCY_MULTIPLIER
EMERGENCY_MULTIPLIER=1.5

PORT=3000
